# AngelOS Production Environment Variables Template
# Copy this file to .env.local on your VPS and fill in your values

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================================================
# SITE CONFIGURATION
# ============================================================================
# Your production domain (with https://)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Node environment (always 'production' for VPS)
NODE_ENV=production

# ============================================================================
# OPTIONAL CONFIGURATIONS
# ============================================================================
# Analytics (if you're using any)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (error tracking, if needed)
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# ============================================================================
# IMPORTANT NOTES
# ============================================================================
# 1. NEVER commit this file with real values to Git
# 2. Keep .env.local in .gitignore
# 3. Make sure to restart PM2 after changing these values:
#    pm2 restart angelos
# 4. Verify variables are loaded: pm2 logs angelos
